# Copied to .env by `npm run bootstrap`. .env is gitignored — never commit it.
# Every value here is optional. The agent starts with zero accounts and
# zero keys; add API keys only when a strategy actually needs one.

# ── Keystore ────────────────────────────────────────────────────────────
# Set before running bootstrap to encrypt wallet keys at rest.
CRYTICAL_KEYSTORE_PASSPHRASE=

# ── Wallet addresses (filled in by bootstrap; public, not secrets) ─────
TREASURY_ADDRESS=
OPS_EVM_ADDRESS=
OPS_SOL_ADDRESS=

# ── RPC endpoints (public defaults are used when empty) ────────────────
RPC_BASE=
RPC_OPTIMISM=
RPC_ARBITRUM=
RPC_POLYGON=
RPC_GNOSIS=
RPC_UNICHAIN=
RPC_SOLANA=

# ── Gas sponsorship / relayers / paymasters ────────────────────────────
# Safe's public relayer needs no key. The rest are free-tier signups.
GELATO_API_KEY=
PIMLICO_API_KEY=
ZERODEV_PROJECT_ID=
BICONOMY_API_KEY=
ALCHEMY_API_KEY=
ALCHEMY_GAS_POLICY_ID=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CANDIDE_API_KEY=

# ── Agent platforms ────────────────────────────────────────────────────
# Zora: API key is optional (raises rate limits). The CLI can use
# ZORA_PRIVATE_KEY; point it at the ops-evm wallet at runtime, not here.
ZORA_API_KEY=
# Bankr: bk_... key from `bankr login`.
BANKR_API_KEY=
NEYNAR_API_KEY=
